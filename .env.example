# Environment Variables for VeriQO
# Copy this file to .env.local and fill in actual values
# NEVER commit .env.local to version control

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://veriQO_user:veriQO_pass@localhost:5432/veriQO_db?schema=public"

# ─── NextAuth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Storage (Phase 1: local filesystem) ────────────────────
# Options: "local" | "s3" (Phase 2+)
STORAGE_PROVIDER="local"
# Local storage path (relative to project root, Phase 1 only)
LOCAL_STORAGE_PATH="./uploads"

# ─── Phase 2+ (leave blank until Phase 2) ───────────────────
# Gemini Vision API key — server-side ONLY, never NEXT_PUBLIC_
GEMINI_API_KEY=""

# ─── Phase 3+ (leave blank until Phase 3) ───────────────────
# Search / verification API key — server-side ONLY
SEARCH_API_KEY=""

# ─── Phase 2+ S3-compatible storage (leave blank until Phase 2) ─
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── App (safe public branding — no secrets) ─────────────────
NEXT_PUBLIC_APP_NAME="VeriQO"
NEXT_PUBLIC_APP_VERSION="0.1.0"
